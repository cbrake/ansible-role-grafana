[Unit]
# comment test
Description=Grafana instance
Documentation=http://docs.grafana.org
Wants=network-online.target
After=network-online.target
After=postgresql.service mariadb.service mysql.service


[Service]
User=grafana
Group=grafana
Type=simple
Restart=on-failure
WorkingDirectory={{ install_dir }}
ExecStart={{ install_dir }}/bin/grafana server --config={{ config_dir }}/grafana.ini \
                            cfg:default.paths.logs={{ log_dir }} \
                            cfg:default.paths.data={{ data_dir }} \
                            cfg:default.paths.plugins={{ data_dir }}/plugins \
                            cfg:default.paths.provisioning={{ provisioning_dir }}
LimitNOFILE=10000
{% set memory_limits = [memory_high_mb | int, memory_max_mb | int] | select('gt', 0) | list %}
{% if memory_high_mb | int > 0 %}
MemoryHigh={{ memory_high_mb }}M
{% endif %}
{% if memory_max_mb | int > 0 %}
MemoryMax={{ memory_max_mb }}M
{% endif %}
{% if memory_limits %}
Environment=GOMEMLIMIT={{ (memory_limits | min * 0.8) | int }}MiB
{% endif %}
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
